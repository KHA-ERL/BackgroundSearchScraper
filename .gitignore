# ─── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env*.backup
# NOTE: .env.local.example is intentionally committed so contributors know
# which variables to configure. It must NOT contain real secrets.

