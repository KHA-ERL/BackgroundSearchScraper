# ─── Build Output ──────────────────────────────────────────────────────────────
.next/
out/

# ─── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# NOTE: .env.local.example is intentionally committed so contributors know
# which variables to configure. It must NOT contain real secrets.

# ─── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ─── WhatsApp Browser Session ──────────────────────────────────────────────────
# Contains Chromium profile data including WhatsApp Web authentication cookies.
# NEVER commit — anyone with this data can access the WhatsApp account.
.whatsapp_session/
.whatsapp/

